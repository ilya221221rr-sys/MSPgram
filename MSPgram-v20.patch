+.ai-thumb-info { display: flex; flex-direction: column; font-size: 12.5px; color: var(--muted); } .ai-thumb-info b { color: var(--text); font-size: 13.5px; }
+.ai-pic { display: block; max-width: 100%; max-height: 240px; border-radius: 12px; margin: 0 0 6px; object-fit: cover; }
+.ai-keycard p { margin: 6px 0 10px; font-size: 13.5px; color: var(--muted); }
+.ai-keycard a { color: var(--accent); }
+.ai-keyrow { display: flex; gap: 8px; } .ai-keyrow input { flex: 1; min-width: 0; }
