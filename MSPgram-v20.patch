+
+.vcircle { position: relative; width: min(240px, 62vw); aspect-ratio: 1; cursor: pointer; margin: 2px 0 4px; -webkit-tap-highlight-color: transparent; }
+.vcircle video { position: absolute; inset: 5.5%; width: 89%; height: 89%; object-fit: cover; border-radius: 50%; background: rgba(0,0,0,.4); }
+.vcircle .rg-bg { stroke: rgba(255,255,255,.18); }
+.vcircle .rg-fg { stroke: #fff; }
+.msg-row:not(.own) .vcircle .rg-fg { stroke: var(--accent); }
+.vc-badge { position: absolute; left: 9%; bottom: 9%; padding: 2px 8px; border-radius: 99px; font-size: 11.5px; font-weight: 600;
+  background: rgba(0,0,0,.55); color: #fff; font-variant-numeric: tabular-nums; }
+.vc-play { position: absolute; inset: 0; margin: auto; width: 54px; height: 54px; border-radius: 50%; display: grid; place-items: center;
+  background: rgba(0,0,0,.42); color: #fff; font-size: 20px; padding-left: 3px; backdrop-filter: blur(4px); transition: opacity .2s, transform .2s; }
+.vcircle.playing .vc-play { opacity: 0; transform: scale(.7); }
+
