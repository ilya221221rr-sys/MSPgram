+.ai-thumb { position: relative; width: 54px; height: 54px; flex: none; }
+.ai-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 12px; }
+.ai-thumb button { position: absolute; top: -7px; right: -7px; width: 22px; height: 22px; border-radius: 50%; border: none; cursor: pointer;
