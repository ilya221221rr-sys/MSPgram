+    const mime = pick();
+
+    const o = el(`
+      <div class="circ-overlay">
+        <div class="circ-top"><span class="circ-dot"></span><span class="circ-time">0:00</span></div>
+        <div class="circ-stage">
+          <video class="circ-preview mirror" autoplay muted playsinline></video>
+          ${ringSvg('circ-ring')}
