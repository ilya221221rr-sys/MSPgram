+/* ============================================================
+   MSPgram v20 «Aurora»
+   • нижняя панель-«док»          • звонки: камера, свёрнутая плашка
+   • история звонков в чате       • видеокружки как в Telegram
+   • загрузка фото в ИИ
+   ============================================================ */
+
+/* ---------- Нижняя панель (док) ---------- */
+.side-nav.dock {
+  position: relative; margin: 4px 10px calc(10px + env(safe-area-inset-bottom, 0px)); padding: 6px 6px;
+  gap: 2px; border-radius: 28px; border: 1px solid color-mix(in srgb, var(--line) 75%, #fff 8%);
+  background: linear-gradient(180deg, color-mix(in srgb, var(--panel2) 86%, transparent), color-mix(in srgb, var(--panel) 92%, transparent));
+  backdrop-filter: blur(20px) saturate(1.5); -webkit-backdrop-filter: blur(20px) saturate(1.5);
+  box-shadow: 0 14px 38px rgba(0,0,0,.42), inset 0 1px 0 rgba(255,255,255,.07);
+}
+.dock .nav-btn { border-radius: 22px; padding: 7px 2px 5px; gap: 3px; color: var(--muted); isolation: isolate; }
+.dock .nav-btn::after { display: none !important; }
+.dock .nav-ic {
+  position: relative; width: 46px; height: 30px; display: grid; place-items: center; border-radius: 15px;
+  transition: background .25s var(--ease), color .2s, transform .25s var(--ease), box-shadow .25s;
+}
+.dock .nav-btn:hover { background: transparent; color: var(--text); }
+.dock .nav-btn:hover .nav-ic { background: color-mix(in srgb, var(--accent) 12%, transparent); }
+.dock .nav-btn:active .nav-ic { transform: scale(.88); }
+.dock .nav-btn.active { color: var(--text); }
+.dock .nav-btn.active .nav-ic {
+  background: linear-gradient(135deg, var(--accent), var(--accent2)); color: #fff;
+  box-shadow: 0 6px 18px color-mix(in srgb, var(--accent) 50%, transparent); transform: translateY(-2px);
+}
+.dock .nav-btn em { font-size: 10.5px; letter-spacing: .01em; }
+
+/* MSP AI — особая кнопка */
+.dock .nav-ai .nav-ic {
+  color: #fff; width: 52px; height: 34px; border-radius: 17px; margin-top: -10px;
+  background: linear-gradient(135deg, #7c5bff, #5b8cff 55%, #38d6ff);
+  box-shadow: 0 8px 22px color-mix(in srgb, var(--accent2) 55%, transparent), inset 0 1px 0 rgba(255,255,255,.35);
+  animation: dock-glow 3.6s ease-in-out infinite;
+}
+.dock .nav-ai em { color: var(--accent); font-weight: 700; margin-top: -1px; }
+@keyframes dock-glow { 0%,100% { filter: brightness(1); } 50% { filter: brightness(1.18) saturate(1.15); } }
+
+/* Профиль — аватар */
+.dock .nav-me .nav-ic { background: transparent; }
+.dock .nav-me .avatar { width: 28px; height: 28px; font-size: 11px; border-radius: 50%;
+  outline: 2px solid color-mix(in srgb, var(--accent) 60%, transparent); outline-offset: 1px; }
+.dock .nav-me .me-av { position: relative; display: inline-flex; }
+.dock .nav-me .me-dot { right: -2px; bottom: -2px; }
+.dock .nav-me:hover .avatar { outline-color: var(--accent); }
+.dock .nav-btn .nbadge { top: 1px; right: calc(50% - 28px); z-index: 2; }
+:root[data-theme="light"] .side-nav.dock { box-shadow: 0 10px 30px rgba(30,40,80,.16), inset 0 1px 0 rgba(255,255,255,.8); }
+
+@media (max-width: 900px) {
+  .side-nav.dock { margin: 4px 10px calc(10px + env(safe-area-inset-bottom, 0px)); }
+}
+@media (max-width: 1100px) and (min-width: 901px) {
+  .dock .nav-btn em { display: none; }
+  .dock .nav-ai .nav-ic { margin-top: 0; }
+}
+
+/* ---------- Звонок ---------- */
+.call-overlay.in-call {
+  background: radial-gradient(120% 90% at 50% 0%, rgba(60,80,170,.55), rgba(4,6,14,.96) 62%);
+  z-index: 160; overflow: hidden;
+}
+.call-overlay.in-call .call-remote-video {
+  position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; object-fit: cover;
+  opacity: 0; transition: opacity .3s; background: #000;
+}
+.call-overlay.in-call.cam-remote .call-remote-video { opacity: 1; }
+.call-shade { position: absolute; inset: 0; z-index: 1; pointer-events: none; opacity: 0; transition: opacity .3s;
+  background: linear-gradient(180deg, rgba(0,0,0,.55), transparent 28%, transparent 62%, rgba(0,0,0,.65)); }
+.call-overlay.cam-remote .call-shade { opacity: 1; }
+.call-overlay.in-call .call-stage { z-index: 2; }
+.call-top-btn {
+  position: fixed; top: calc(14px + env(safe-area-inset-top, 0px)); left: 14px; z-index: 5;
+  width: 42px; height: 42px; border-radius: 50%; border: 1px solid rgba(255,255,255,.2);
+  background: rgba(255,255,255,.12); color: #fff; cursor: pointer; display: grid; place-items: center;
+  backdrop-filter: blur(10px);
+}
+.call-top-btn:hover { background: rgba(255,255,255,.22); }
+.call-overlay.in-call .call-controls { flex-wrap: wrap; gap: 12px; }
+.call-overlay.in-call .call-btn.on { background: #fff; color: #111; border-color: #fff; }
+.call-overlay.in-call .call-btn.off { background: var(--danger) !important; color: #fff; border-color: transparent; }
+.call-overlay.in-call .hang-ic svg { transform: rotate(135deg); }
+#call-expand { display: none; }
+.call-overlay.in-call .call-local-video {
+  display: none; position: fixed; right: 16px; top: calc(16px + env(safe-area-inset-top, 0px)); z-index: 4;
+  width: 118px; height: 168px; object-fit: cover; border-radius: 18px;
+  border: 1px solid rgba(255,255,255,.28); box-shadow: 0 12px 40px rgba(0,0,0,.55); background: #000;
+}
+.call-overlay.in-call.cam-local .call-local-video { display: block; animation: nova-pop .25s var(--ease); }
+.call-local-video.mirror { transform: scaleX(-1); }
+.call-overlay.in-call .call-avatar-wrap { transition: opacity .3s, transform .3s; }
+.call-overlay.in-call.connected:not(.cam-remote) .call-avatar-wrap::after {
+  content: ''; position: absolute; inset: -10px; border-radius: 50%; border: 2px solid rgba(91,140,255,.45);
+  animation: ringpulse 2.2s ease-out infinite; pointer-events: none;
+}
+/* видео собеседника на весь экран: имя — сверху, кнопки — снизу */
+.call-overlay.in-call.cam-remote .call-stage {
+  position: fixed; inset: 0; width: auto; display: flex; flex-direction: column; justify-content: space-between;
+  padding: calc(16px + env(safe-area-inset-top, 0px)) 16px calc(26px + env(safe-area-inset-bottom, 0px));
+}
+.call-overlay.in-call.cam-remote .call-avatar-wrap { display: none; }
+.call-overlay.in-call.cam-remote .call-info { text-align: center; text-shadow: 0 2px 12px rgba(0,0,0,.7); }
+.call-overlay.in-call.cam-remote .call-name { font-size: 20px; }
+.call-overlay.in-call.cam-remote .call-controls { margin: 0; }
+
+/* свёрнутый звонок — плашка сверху, приложением можно пользоваться */
+.call-overlay.in-call.mini {
+  inset: auto; top: calc(6px + env(safe-area-inset-top, 0px)); left: 50%; transform: translateX(-50%);
+  width: min(94vw, 440px); height: 50px; border-radius: 26px; z-index: 150; cursor: pointer;
+  background: linear-gradient(90deg, #1b9a68, #2b78d6); border: 1px solid rgba(255,255,255,.25);
+  box-shadow: 0 10px 30px rgba(0,0,0,.45); backdrop-filter: none; display: block; animation: nova-pop .22s var(--ease);
+}
+.call-overlay.mini .call-remote-video { opacity: 0 !important; inset: auto; top: 0; left: 0; width: 2px; height: 2px; }
+.call-overlay.mini .call-shade, .call-overlay.mini .call-top-btn, .call-overlay.mini .call-local-video { display: none !important; }
+.call-overlay.mini .call-stage {
+  position: relative !important; inset: auto !important; width: 100% !important; height: 100%; padding: 0 8px 0 8px !important;
+  display: flex !important; flex-direction: row !important; align-items: center; gap: 10px; text-align: left;
+}
+.call-overlay.mini .call-avatar-wrap { display: block !important; width: 36px; height: 36px; margin: 0; flex: none; }
+.call-overlay.mini .call-avatar-wrap::after { display: none; }
+.call-overlay.mini .call-avatar-wrap .avatar { width: 36px !important; height: 36px !important; font-size: 14px !important; border-radius: 50%; }
+.call-overlay.mini .call-info { flex: 1; min-width: 0; text-align: left !important; text-shadow: none !important; }
+.call-overlay.mini .call-name { font-size: 14px !important; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; line-height: 1.15; }
+.call-overlay.mini .call-status { margin: 0; font-size: 12px; color: rgba(255,255,255,.85); }
+.call-overlay.mini .call-controls { margin: 0 !important; gap: 6px !important; flex-wrap: nowrap; }
+.call-overlay.mini .call-btn, .call-overlay.mini .call-btn.big { width: 36px; height: 36px; }
+.call-overlay.mini #call-cam, .call-overlay.mini #call-flip, .call-overlay.mini #call-pip { display: none !important; }
+.call-overlay.mini #call-expand { display: flex; }
+.call-overlay.mini .hang-ic svg { width: 18px; height: 18px; }
+body.call-mini .app {
+  margin-top: calc(58px + env(safe-area-inset-top, 0px)); height: calc(100dvh - 58px - env(safe-area-inset-top, 0px));
+}
+
+/* ---------- История звонков в чате ---------- */
+.msg-row.call-row { align-self: center !important; align-items: center; max-width: 92%; margin: 8px 0; }
+.call-card {
+  display: flex; align-items: center; gap: 12px; padding: 8px 8px 8px 10px; min-width: 240px; max-width: 100%;
+  border-radius: 20px; background: color-mix(in srgb, var(--panel2) 92%, transparent);
+  border: 1px solid var(--line); box-shadow: var(--shadow-s);
+}
+.cc-ic { width: 38px; height: 38px; flex: none; border-radius: 50%; display: grid; place-items: center;
+  background: color-mix(in srgb, var(--ok) 18%, transparent); color: var(--ok); }
+.call-card.bad .cc-ic { background: color-mix(in srgb, var(--danger) 18%, transparent); color: var(--danger); }
+.call-card.neutral .cc-ic { background: var(--hover); color: var(--muted); }
+.cc-txt { flex: 1; min-width: 0; display: flex; flex-direction: column; line-height: 1.25; }
+.cc-txt b { font-size: 14px; font-weight: 700; }
+.call-card.bad .cc-txt b { color: var(--danger); }
+.cc-txt span { font-size: 12px; color: var(--muted); }
+.cc-dir { font-style: normal; font-weight: 800; color: var(--ok); }
+.call-card.bad .cc-dir { color: var(--danger); }
+.call-card.neutral .cc-dir { color: var(--muted); }
+.cc-again { width: 36px; height: 36px; flex: none; border: none; border-radius: 50%; cursor: pointer; color: var(--accent);
+  background: color-mix(in srgb, var(--accent) 14%, transparent); display: grid; place-items: center; transition: transform .1s, background .15s; }
+.cc-again:hover { background: color-mix(in srgb, var(--accent) 26%, transparent); }
+.cc-again:active { transform: scale(.9); }
+
+/* ---------- Видеокружки ---------- */
+.circ-overlay {
+  position: fixed; inset: 0; z-index: 180; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 22px;
+  background: rgba(5,8,18,.92); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); animation: nova-pop .2s var(--ease);
+  padding: env(safe-area-inset-top, 0px) 16px env(safe-area-inset-bottom, 0px);
+}
+.circ-top { display: flex; align-items: center; gap: 8px; color: #fff; font-weight: 700; font-variant-numeric: tabular-nums; font-size: 18px; }
+.circ-dot { width: 10px; height: 10px; border-radius: 50%; background: #777; }
+.circ-overlay.live .circ-dot { background: #ff4d57; animation: blink 1s infinite; }
+.circ-stage { position: relative; width: min(78vw, 340px); aspect-ratio: 1; }
+.circ-preview { position: absolute; inset: 6%; width: 88%; height: 88%; object-fit: cover; border-radius: 50%; background: #000;
+  box-shadow: 0 20px 70px rgba(0,0,0,.6); }
+.mirror { transform: scaleX(-1); }
+.circ-ring, .vc-ring { position: absolute; inset: 0; width: 100%; height: 100%; transform: rotate(-90deg); pointer-events: none; }
+.rg-bg { fill: none; stroke: rgba(255,255,255,.14); stroke-width: 2.4; }
+.rg-fg { fill: none; stroke: var(--accent); stroke-width: 2.8; stroke-linecap: round; transition: stroke-dashoffset .25s linear; }
+.circ-overlay.live .rg-fg { stroke: #ff4d57; transition-duration: .1s; }
+.circ-hint { color: rgba(232,237,248,.7); font-size: 13.5px; text-align: center; max-width: 280px; min-height: 36px; }
+.circ-actions { display: flex; align-items: center; gap: 26px; }
+.circ-btn { width: 52px; height: 52px; border-radius: 50%; border: 1px solid rgba(255,255,255,.2); background: rgba(255,255,255,.1); color: #fff;
+  display: grid; place-items: center; cursor: pointer; transition: transform .1s, background .15s; }
+.circ-btn:hover { background: rgba(255,255,255,.2); } .circ-btn:active { transform: scale(.9); }
+.circ-rec { width: 78px; height: 78px; border-radius: 50%; border: 4px solid #fff; background: transparent; cursor: pointer; display: grid; place-items: center; padding: 0; transition: transform .1s; }
+.circ-rec i { width: 56px; height: 56px; border-radius: 50%; background: #ff4d57; transition: all .2s var(--ease); }
+.circ-rec:active { transform: scale(.94); }
